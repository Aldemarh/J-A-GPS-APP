# Copiar este archivo a .env y completar los valores.
# .env NUNCA se sube al repositorio.

NODE_ENV=development
PORT=4000

# Frontend autorizado a llamar a la API (CORS). Separar varios con coma.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://gps_user:cambia_esta_clave@localhost:5432/jya_gps
# Pool de conexiones
DB_POOL_MAX=10
# Activar SSL en producción (true/false)
DB_SSL=false

# JWT (mínimo 32 caracteres; generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h
