# Copia este archivo como .env.local y completa los valores (.env.local no se sube a git).

# Key de Google Maps. Vacía: la app usa el mapa de OpenStreetMap.
# Para pruebas sirve la Maps Demo Key (sin tarjeta): https://developers.google.com/maps/demo-key
VITE_GOOGLE_MAPS_API_KEY=

# Map ID de Google Cloud (opcional). Vacío: se usa DEMO_MAP_ID, el de pruebas de Google.
VITE_GOOGLE_MAPS_MAP_ID=

# Dirección de la API en desarrollo (opcional). Por defecto http://localhost:4000
# VITE_API_PROXY_TARGET=http://localhost:4000
